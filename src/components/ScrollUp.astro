---

---

<button class="scrollup" id="scroll-up" type="button" aria-label="Scroll to top">
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="24"
		height="24"
		viewBox="0 0 18.256 18.256"
		style="transition:.3s"
		class="scrollup__icon"
	>
		<g transform="translate(5.363 5.325)">
			<path
				d="M14.581,7.05,7.05,14.581"
				transform="translate(-7.05 -7.012)"
				fill="none"
				stroke="var(--container-color)"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.5"></path>
			<path
				d="M10,7l5.287.037.038,5.287"
				transform="translate(-7.756 -7)"
				fill="none"
				stroke="var(--container-color)"
				stroke-linecap="round"
				stroke-linejoin="round"
				stroke-width="1.5"></path>
		</g>
		<path d="M0,0H18.256V18.256H0Z" fill="none"></path>
	</svg>
</button>

<script>
	function setupScrollUp() {
		const scrollUp = document.getElementById('scroll-up') as HTMLButtonElement | null;
		if (!scrollUp) return;

		// Attach the click handler once (guard against re-init duplicates).
		if (!scrollUp.dataset.bound) {
			scrollUp.addEventListener('click', () => {
				window.scrollTo({ top: 0 });
			});
			scrollUp.dataset.bound = 'true';
		}

		const onScroll = () => {
			scrollUp.classList.toggle('show-scroll', window.scrollY >= 200);
		};
		// Replace any listener from a previous page to avoid stacking.
		const w = window as any;
		if (w.__scrollUpHandler) window.removeEventListener('scroll', w.__scrollUpHandler);
		w.__scrollUpHandler = onScroll;
		window.addEventListener('scroll', onScroll);
		onScroll();
	}

	document.addEventListener('astro:page-load', setupScrollUp);
</script>

<style>
	.scrollup {
		position: fixed;
		right: 1rem;
		bottom: -20%;
		background-color: var(--first-color);
		border: 0;
		opacity: 0;
		padding: 0.5rem;
		border-radius: 0.5rem;
		z-index: var(--z-tooltip);
		transition: 0.4s;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}

	.scrollup:hover {
		background-color: var(--first-color-alt);
	}

	.scrollup__icon {
		font-size: 1.5rem;
		color: var(--container-color);
		rotate: 315deg;
	}

	.show-scroll {
		bottom: 6rem;
		opacity: 1;
	}

	@media screen and (min-width: 768px) {
		.show-scroll {
			bottom: 1rem;
		}
	}
</style>
