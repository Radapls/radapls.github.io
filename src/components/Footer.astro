---
import Logo from '@assets/img/JFRA.svg';
import WcagBadge from '@assets/img/wcag21-aa-blue.svg';
import CcBadge from '@assets/img/license-cc-by-sa.svg';
import AgplBadge from '@assets/img/license-agpl.svg';
import { Image } from 'astro:assets';
import type { BrandType } from 'src/types/variants';
import { useTranslations, type Lang } from 'src/i18n';

interface Props {
	variant?: BrandType;
}

const t = useTranslations(Astro.currentLocale as Lang);
---

<footer class="footer__bg">
	<div class="footer__container">
		<div class="footer__brand-container">
			<Logo
				class="brand-image"
				role="img"
				aria-label="Logo Juan Felipe Rada"
				height={30}
				width={30}
			/>
			<p class="footer__title">
				<span>
					&copy; {new Date().getFullYear() + ' '}
				</span>
				Juan Felipe Rada
			</p>
		</div>
	</div>
	<div class="footer__a11y">
		<label class="a11y-switch" for="reduce-motion">
			<input type="checkbox" id="reduce-motion" class="a11y-switch__input" />
			<span class="a11y-switch__track" aria-hidden="true">
				<span class="a11y-switch__thumb"></span>
			</span>
			<span class="a11y-switch__label">
				{
					t({
						en: 'Reduce animations',
						es: 'Reducir animaciones',
						'pt-br': 'Reduzir animações',
					})
				}
			</span>
		</label>
	</div>
	<div class="footer__badges">
		<a
			href="https://creativecommons.org/licenses/by-sa/4.0/"
			aria-label={t({
				en: 'Posts licensed under CC BY-SA 4.0',
				es: 'Publicaciones bajo licencia CC BY-SA 4.0',
				'pt-br': 'Publicações sob licença CC BY-SA 4.0',
			})}
		>
			<Image src={CcBadge} alt="CC BY-SA 4.0" width={88} height={31} loading="lazy" />
		</a>
		<a
			href="https://github.com/Radapls/radapls.github.io/blob/main/LICENSE"
			aria-label={t({
				en: 'Source code licensed under AGPL-3.0',
				es: 'Código fuente bajo licencia AGPL-3.0',
				'pt-br': 'Código-fonte sob licença AGPL-3.0',
			})}
		>
			<Image src={AgplBadge} alt="AGPL-3.0" width={94} height={31} loading="lazy" />
		</a>
		<a
			href="https://www.w3.org/WAI/WCAG2AA-Conformance"
			rel="noopener noreferrer"
			aria-label={t({
				en: 'WCAG 2.1 Level AA conformance claim',
				es: 'Declaración de conformidad WCAG 2.1 nivel AA',
				'pt-br': 'Declaração de conformidade WCAG 2.1 nível AA',
			})}
		>
			<Image src={WcagBadge} alt="WCAG 2.1 Level AA" width={88} height={31} loading="lazy" />
		</a>
	</div>
</footer>

<style>
	.footer__container {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 3rem;
	}

	.footer__bg {
		padding: 3rem 0;
		position: relative;
	}

	.footer__title {
		font-size: var(--normal-font-size);
		display: inline;
		color: var(--text-color);
	}
	span {
		font-weight: var(--font-medium);
	}

	.footer__brand-container {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.footer__badges {
		display: flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.5rem;
	}

	:global(.dark) .brand-image {
		filter: grayscale(1) contrast(0.5) brightness(3.5);
	}

	/* a11y switch: real checkbox visually replaced by a track + thumb */
	.footer__a11y {
		display: flex;
		justify-content: center;
		margin-top: 1.5rem;
	}
	.a11y-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		cursor: pointer;
		user-select: none;
	}
	.a11y-switch__input {
		position: absolute;
		opacity: 0;
		width: 1px;
		height: 1px;
	}
	.a11y-switch__track {
		width: 2.75rem;
		height: 1.5rem;
		border-radius: var(--radius-pill);
		background: color-mix(in srgb, var(--title-color) 25%, transparent);
		padding: 0.1875rem;
		display: flex;
		align-items: center;
		transition: background 200ms ease-in-out;
	}
	.a11y-switch__thumb {
		width: 1.125rem;
		height: 1.125rem;
		border-radius: 50%;
		background: var(--title-color);
		transition: translate 200ms ease-in-out;
	}
	.a11y-switch__input:checked + .a11y-switch__track {
		background: var(--first-color);
	}
	.a11y-switch__input:checked + .a11y-switch__track .a11y-switch__thumb {
		translate: 1.25rem 0;
	}
	.a11y-switch__input:focus-visible + .a11y-switch__track {
		outline: 2px solid var(--first-color);
		outline-offset: 2px;
	}
	.a11y-switch__label {
		font-size: var(--smaller-font-size);
		color: var(--text-color);
	}
</style>

<script>
	// Reduce-motion switch (WCAG 2.2.2 Pause/Stop/Hide): pauses every
	// autoplaying video and kills CSS animations/transitions. Defaults
	// to the OS prefers-reduced-motion setting; an explicit choice is
	// remembered in localStorage.
	const KEY = 'reduce-motion';

	function apply(on: boolean) {
		document.documentElement.toggleAttribute('data-reduce-motion', on);
		document.querySelectorAll('video').forEach((v) => {
			if (on) v.pause();
			else void v.play().catch(() => {});
		});
	}

	function init() {
		const box = document.getElementById('reduce-motion') as HTMLInputElement | null;
		if (!box) return;
		const saved = localStorage.getItem(KEY);
		const on =
			saved !== null ? saved === '1' : matchMedia('(prefers-reduced-motion: reduce)').matches;
		box.checked = on;
		apply(on);
		box.addEventListener('change', () => {
			localStorage.setItem(KEY, box.checked ? '1' : '0');
			apply(box.checked);
		});
	}

	document.addEventListener('astro:page-load', init);
	init();
</script>
