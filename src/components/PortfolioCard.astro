---
import { Image } from 'astro:assets';

interface Props {
	link: string;
	bgImage: any;
	title: string;
	description: string;
}

const { link, bgImage, title, description } = Astro.props;
---

<a class="card" href=`${link}` target="_blank" rel="noopener noreferrer">
	<span class="card__thumb">
		<Image
			class="card__image"
			src={bgImage}
			alt={title}
			loading="lazy"
			width={132}
			height={132}
		/>
	</span>
	<div class="card__content">
		<h3 class="card__title" id={`title-${title}`}>
			{title}
		</h3>
		<p class="card__description">
			{description}
		</p>
	</div>
	<span class="card__arrow" aria-hidden="true">
		<svg
			id="Arrow.7"
			xmlns="http://www.w3.org/2000/svg"
			width="20"
			height="20"
			viewBox="0 0 18.256 18.256"
			style="transition:.3s"
		>
			<g id="Group_7" data-name="Group 7" transform="translate(5.363 5.325)">
				<path
					id="Path_10"
					data-name="Path 10"
					d="M14.581,7.05,7.05,14.581"
					transform="translate(-7.05 -7.012)"
					fill="none"
					stroke="var(--container-color)"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="1.5"></path>
				<path
					id="Path_11"
					data-name="Path 11"
					d="M10,7l5.287.037.038,5.287"
					transform="translate(-7.756 -7)"
					fill="none"
					stroke="var(--container-color)"
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="1.5"></path>
			</g>
			<path id="Path_12" data-name="Path 12" d="M0,0H18.256V18.256H0Z" fill="none"></path>
		</svg>
	</span>
</a>

<style>
	/* Icon-forward card: the artwork renders at a small size (where the
	   source images are sharp) instead of a stretched cover image. */
	.card {
		position: relative;
		box-shadow: var(--shadow-sm);
		border-radius: var(--radius-md);
		overflow: hidden;
		background-color: var(--container-color);
		display: flex;
		align-items: flex-start;
		gap: 1.25rem;
		padding: 1.25rem 1.5rem;
		text-decoration: none;
		width: 100%;
		transition:
			box-shadow 200ms ease-in-out,
			transform 200ms ease-in-out;
	}

	.card:hover {
		box-shadow: var(--shadow-md);
		transform: translateY(-3px);
	}

	.card__thumb {
		flex: none;
		width: 88px;
		height: 88px;
		border-radius: var(--radius-md);
		background-color: color-mix(in srgb, var(--title-color) 6%, transparent);
		display: grid;
		place-items: center;
		overflow: hidden;
	}
	.card__image {
		width: 100%;
		height: 100%;
		object-fit: contain;
		padding: 0.5rem;
	}

	.card__content {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		padding-right: 2rem; /* room for the arrow badge */
	}
	.card__title {
		font-size: var(--h3-font-size);
		font-weight: var(--font-medium);
	}
	.card__description {
		font-size: var(--smaller-font-size);
		color: var(--text-color);
	}

	.card__arrow {
		position: absolute;
		top: 1rem;
		right: 1rem;
		background-color: var(--first-color);
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0.75rem;
		transition: 300ms ease-in-out;
	}
	.card:hover .card__arrow {
		background-color: var(--first-color-alt);
		rotate: 45deg;
	}

	@media screen and (max-width: 768px) {
		.card__arrow {
			padding: 0.5rem;
		}
	}
</style>
