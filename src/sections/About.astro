---
import Flag from '@components/Flag.astro';

import { useTranslations, type Lang } from 'src/i18n';

const t = useTranslations(Astro.currentLocale as Lang);
---

<!--==================== ABOUT ====================-->
<!-- Brief intro → personal objects (the flag from my room;
     a poster slot can join the shelf later). -->
<section class="about section" id="About">
	<h2 class="section__title">
		{
			t({
				en: 'About me',
				es: 'Acerca de mí',
				'pt-br': 'Sobre mim',
			})
		}
	</h2>

	<div class="about__container container">
		<div class="about__intro">
			<p class="about__lead">
				{
					t({
						en: 'My name is Juan Felipe Rada, currently working as a UX/UI developer in the telecommunications sector. I am curious about understanding the details of interfaces, seeing how those small touches make a big change in the user experience. I have worked in different technology sectors, always trying to bring a human touch to development.',
						es: 'Mi nombre es Juan Felipe Rada, actualmente trabajo como desarrollador UX/UI en el sector de telecomunicaciones. Me da curiosidad entender los detalles de las interfaces, ver como esos pequeños toques dan un gran cambio en la experiencia de los usuarios. He trabajado en diferentes sectores de tecnología, siempre intentando dar un toque humano al desarrollo.',
						'pt-br':
							'Meu nome é Juan Felipe Rada, atualmente trabalho como desenvolvedor UX/UI no setor de telecomunicações. Tenho curiosidade em entender os detalhes das interfaces, ver como esses pequenos toques fazem uma grande mudança na experiência do usuário. Trabalhei em diferentes setores de tecnologia, sempre tentando trazer um toque humano ao desenvolvimento.',
					})
				}
			</p>

			<p class="about__lead">
				{
					t({
						en: 'Sometimes in my free time I like to write. My opinions are merely personal, and from a very intimate perspective.',
						es: 'A veces en mis tiempos libres me gusta escribir. Mis opiniones son meramente personales, y desde una mirada muy íntima.',
						'pt-br': 'Às vezes no meu tempo livre gosto de escrever. Minhas opiniões são meramente pessoais, e de uma perspectiva muito íntima.',
					})
				}
				<a rel="nofollow" href="/CV_Juan_Felipe_Rada.pdf" target="_blank" class="about__cv">
					{t({ en: 'CV', es: 'CV', 'pt-br': 'CV' })}
					<i class="uil uil-download-alt"></i>
				</a>
			</p>
		</div>

		<div class="about__shelf">
			<Flag />
		</div>
	</div>
</section>

<style>
	/*==================== ABOUT ====================*/
	.about__container {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.25rem;
	}
	/* Intro: one readable measure, left-aligned inside a centered column */
	.about__intro {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 62ch;
	}
	.about__lead {
		text-align: left;
		line-height: 1.7;
		color: var(--text-color);
	}
	.about__cv {
		white-space: nowrap;
		color: var(--first-color);
		font-weight: var(--font-semi-bold);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--first-color) 40%, transparent);
		text-underline-offset: 3px;
		transition: text-decoration-color 200ms ease-in-out;
	}
	.about__cv:hover {
		color: var(--first-color-alt);
		text-decoration-color: currentColor;
	}
	.about__cv i {
		font-size: 0.9em;
		margin-left: 0.15rem;
	}

	/* Personal shelf: real objects from my room — flag now, poster later */
	.about__shelf {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
		width: 100%;
	}
</style>
