---
import Flag from '@components/Flag.astro';
import TypeSpecimen from '@components/TypeSpecimen.astro';
import Moai from '@components/Moai.astro';
import RaceBibs from '@components/RaceBibs.astro';
import Logo from '@assets/img/JFRA.svg';

import { useTranslations, type Lang } from 'src/i18n';

const t = useTranslations(Astro.currentLocale as Lang);
---

<section class="about section" id="About">
	<h2 class="section__title">
		{
			t({
				en: 'About me',
				es: 'Acerca de mí',
				'pt-br': 'Sobre mim',
			})
		}
	</h2>

	<div class="about__container container">
		<RaceBibs />

		<div class="about__main">
			<div class="about__shelf">
				<Flag />
			</div>

			<div class="about__row">
				<div class="about__af">
					<TypeSpecimen />
				</div>

				<div class="about__intro">
					<p class="about__lead">
						{
							t({
								en: 'My name is Juan Felipe Rada, currently working as a UI/UX developer in the telecommunications sector. I am curious about understanding the details of interfaces, seeing how those small touches make a big change in the user experience. I have worked in different technology sectors, always trying to bring a human touch to development.',
								es: 'Mi nombre es Juan Felipe Rada, actualmente trabajo como desarrollador UI/UX en el sector de telecomunicaciones. Me da curiosidad entender los detalles de las interfaces, ver como esos pequeños toques dan un gran cambio en la experiencia de los usuarios. He trabajado en diferentes sectores de tecnología, siempre intentando dar un toque humano al desarrollo.',
								'pt-br':
									'Meu nome é Juan Felipe Rada, atualmente trabalho como desenvolvedor UI/UX no setor de telecomunicações. Tenho curiosidade em entender os detalhes das interfaces, ver como esses pequenos toques fazem uma grande mudança na experiência do usuário. Trabalhei em diferentes setores de tecnologia, sempre tentando trazer um toque humano ao desenvolvimento.',
							})
						}
					</p>

					<p class="about__lead">
						{
							t({
								en: 'Sometimes in my free time I like to write. My opinions are merely personal, and from a very intimate perspective.',
								es: 'A veces en mis tiempos libres me gusta escribir. Mis opiniones son meramente personales, y desde una mirada muy íntima.',
								'pt-br':
									'Às vezes no meu tempo livre gosto de escrever. Minhas opiniões são meramente pessoais, e de uma perspectiva muito íntima.',
							})
						}
					</p>
				</div>

				<div class="about__wall">
					<div class="about__moai">
						<Moai />
					</div>

					<a
						rel="nofollow"
						href="/CV_Juan_Felipe_Rada.pdf"
						target="_blank"
						class="about__poster"
						aria-label={t({ en: 'Download CV', es: 'Descargar CV', 'pt-br': 'Baixar CV' })}
					>
						<span class="about__poster-frame">
							<Logo
								class="about__poster-logo"
								role="img"
								aria-hidden="true"
								width={44}
								height={44}
							/>
							<span class="about__poster-text" aria-hidden="true"></span>
							<span class="about__poster-text about__poster-text--short" aria-hidden="true"></span>
							<span class="about__poster-text" aria-hidden="true"></span>
							<span class="about__poster-hint">
								{
									t({
										en: 'Download CV',
										es: 'Descargar CV',
										'pt-br': 'Baixar CV',
									})
								}
								<i class="uil uil-external-link-alt" aria-hidden="true"></i>
							</span>
						</span>
					</a>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	/*==================== ABOUT (a wall of my room) ====================*/
	/* Group the wall around the text instead of stretching to the
	   full-bleed container edges — otherwise the CV drifts to the far
	   side of the screen with a dead gap beside the text. */
	.about__container {
		display: flex;
		align-items: stretch;
		gap: 2.5rem;
		max-width: 72rem;
		margin-inline: auto;
	}
	/* The bibs pin the full height of the left edge: stretch + spread */
	.about__container > :global(.bibs) {
		flex-shrink: 0;
		justify-content: space-between;
	}
	/* Second column: flag on top, the rest of the wall below */
	.about__main {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 2rem;
		min-width: 0;
	}
	.about__row {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 3.5rem;
	}
	/* The framed things that hang together on the right of the wall:
	   moai frame on top, CV poster below it */
	.about__wall {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.75rem;
	}
	/* The specimen poster hangs straight on the left of the wall */
	.about__af {
		flex-shrink: 0;
	}
	/* The moai carving sits dead-center in a square shadow-box frame,
	   like the real one hanging on the wall */
	.about__moai {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 8.5rem;
		height: 8.5rem;
		background: var(--container-color);
		border: 2px solid var(--title-color);
		box-shadow:
			inset 0 0 0 5px var(--body-color),
			inset 0 0 0 6px color-mix(in srgb, var(--title-color) 35%, transparent),
			var(--shadow-md);
	}
	.about__moai :global(.moai) {
		width: 5.5rem;
	}
	/* Intro: one readable measure, left-aligned */
	.about__intro {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
		max-width: 62ch;
	}
	.about__lead {
		text-align: left;
		line-height: 1.7;
		color: var(--text-color);
	}

	/* CV as a framed document hanging on the wall: nail + string + frame
	   with the JFRA logo and text lines, slightly tilted like it was
	   just hung. Decorative bits are aria-hidden pseudo-elements/spans
	   inside a labelled link. */
	.about__poster {
		position: relative;
		flex-shrink: 0;
		display: block;
		padding-top: 2.5rem; /* room for the nail and string */
		text-decoration: none;
	}
	/* the nail: sits on the wall, never moves */
	.about__poster::before {
		content: '';
		position: absolute;
		top: 0;
		left: 50%;
		width: 9px;
		height: 9px;
		transform: translateX(-50%);
		border-radius: 50%;
		background: var(--title-color);
	}
	.about__poster-frame {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.65rem;
		width: 10rem;
		padding: 1.5rem 1.1rem 1.1rem;
		background: var(--container-color);
		border: 2px solid var(--title-color);
		/* inner mat, like a picture frame */
		box-shadow:
			inset 0 0 0 5px var(--body-color),
			inset 0 0 0 6px color-mix(in srgb, var(--title-color) 35%, transparent),
			var(--shadow-md);
		/* the frame hangs from the nail: it pivots on the nail point
		   (top of the strings, above the frame), not its own center —
		   hover straightens the swing while the nail stays put */
		transform-origin: 50% -2.4rem;
		transform: rotate(2.5deg);
		transition: transform 250ms ease-in-out;
	}
	.about__poster:hover .about__poster-frame {
		transform: rotate(0deg);
	}
	/* the string: two lines anchored at the nail (frame top center)
	   and rotating outward toward the frame — both start exactly at
	   the nail so they connect */
	.about__poster-frame::before,
	.about__poster-frame::after {
		content: '';
		position: absolute;
		top: -2.4rem;
		left: 50%;
		height: 2.45rem;
		width: 1px;
		background: var(--text-color);
		opacity: 0.5;
		transform-origin: top center;
	}
	.about__poster-frame::before {
		transform: rotate(38deg);
	}
	.about__poster-frame::after {
		transform: rotate(-38deg);
	}
	.about__poster-logo {
		width: 44px;
		height: auto;
	}
	/* fake document text lines: gray bars under the logo */
	.about__poster-text {
		width: 100%;
		height: 0.4rem;
		border-radius: var(--radius-pill);
		background: color-mix(in srgb, var(--text-color) 22%, transparent);
	}
	.about__poster-text--short {
		width: 65%;
		align-self: flex-start;
	}
	.about__poster-hint {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding-top: 0.75rem;
		border-top: 1px solid color-mix(in srgb, var(--title-color) 25%, transparent);
		font-size: var(--smaller-font-size);
		font-weight: var(--font-semi-bold);
		letter-spacing: 0.05em;
		color: var(--first-color);
	}
	.about__poster-hint i {
		font-size: 0.8rem;
	}

	/* Small screens: keep it lean — title, text and the CV button only.
	   The wall decorations (bibs, flag, specimen, moai) are hidden. */
	@media screen and (max-width: 640px) {
		.about__container > :global(.bibs),
		.about__shelf,
		.about__af,
		.about__moai {
			display: none;
		}
		.about__row {
			flex-direction: column;
			align-items: center;
			gap: 2.5rem;
		}
	}

	/* Flag banner at the top of the second column */
	.about__shelf {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 1.5rem;
	}
</style>
