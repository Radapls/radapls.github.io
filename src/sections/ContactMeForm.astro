---
import { useTranslations, type Lang } from 'src/i18n';
import { GLOBAL_EMAIL, SITE_URL, WHATSAPP } from 'src/consts';

const t = useTranslations(Astro.currentLocale as Lang);
---

<section class="contact section" id="Contact">
	<h2 class="section__title">
		{
			t({
				en: 'Contact details',
				es: 'Datos de contacto',
				'pt-br': 'Dados de contato',
			})
		}
	</h2>

	<div class="contact__container container">
		<form action={`https://formsubmit.co/${GLOBAL_EMAIL}`} method="POST" class="mail">
			<div class="mail__titlebar">
				<span class="mail__dot" aria-hidden="true"></span>
				<span class="mail__dot" aria-hidden="true"></span>
				<span class="mail__dot" aria-hidden="true"></span>
				<span class="mail__title">
					{
						t({
							en: 'New Message',
							es: 'Nuevo mensaje',
							'pt-br': 'Nova mensagem',
						})
					}
				</span>
			</div>

			<div class="mail__head">
				<div class="mail__row">
					<span class="mail__label">
						{t({ en: 'To:', es: 'Para:', 'pt-br': 'Para:' })}
					</span>
					<span class="mail__value">{GLOBAL_EMAIL}</span>
				</div>
				<div class="mail__row">
					<label class="mail__label" for="name">
						{t({ en: 'From:', es: 'De:', 'pt-br': 'De:' })}
					</label>
					<span class="mail__from">
						<input
							id="name"
							name="name"
							type="text"
							class="mail__input"
							placeholder={t({ en: 'Your name', es: 'Tu nombre', 'pt-br': 'Seu nome' })}
							autocomplete="name"
							required
						/>
						&lt;<input
							id="email"
							name="email"
							type="email"
							class="mail__input mail__input--email"
							placeholder="you@mail.com"
							autocomplete="email"
							required
						/>&gt;
					</span>
				</div>
				<div class="mail__row">
					<label class="mail__label" for="project">
						{t({ en: 'Subject:', es: 'Asunto:', 'pt-br': 'Assunto:' })}
					</label>
					<input
						id="project"
						name="project"
						type="text"
						class="mail__input"
						placeholder={t({
							en: 'Let&rsquo;s work together',
							es: 'Trabajemos juntos',
							'pt-br': 'Trabalhemos juntos',
						})}
					/>
				</div>
			</div>

			<textarea
				id="message"
				name="message"
				class="mail__body"
				rows="8"
				required
				wrap="soft"
				placeholder={t({
					en: 'Write your message here…',
					es: 'Escribe tu mensaje aquí…',
					'pt-br': 'Escreva sua mensagem aqui…',
				})}></textarea>

			<div class="mail__toolbar">
				<button type="submit" class="mail__send" id="submit-button">
					<svg
						viewBox="0 0 24 24"
						width="16"
						height="16"
						fill="none"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"
						aria-hidden="true"
					>
						<rect x="2" y="4" width="20" height="16" rx="2"></rect>
						<path d="m22 7-10 6L2 7"></path>
					</svg>
					{
						t({
							en: 'Send',
							es: 'Enviar',
							'pt-br': 'Enviar',
						})
					}
				</button>
			</div>

			<input type="hidden" name="_next" value={`${SITE_URL}/thanks`} />
			<input type="hidden" name="_subject" value="Nuevo mensaje de Portafolio" />
		</form>

		<a class="contact__alt" href={WHATSAPP as string}>
			{
				t({
					en: '…or text me on WhatsApp',
					es: '…o escríbeme por WhatsApp',
					'pt-br': '…ou me chama no WhatsApp',
				})
			}
		</a>
	</div>
</section>

<style>
	/*==================== CONTACT: retro mail window ====================*/
	.contact__container {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25rem;
	}
	.contact__alt {
		font-size: var(--small-font-size);
		color: var(--text-color-light);
	}
	.contact__alt:hover {
		color: var(--first-color);
	}

	.mail {
		width: min(100%, 560px);
		background-color: #d6d3ce;
		border: 1px solid #000;
		box-shadow: var(--shadow-lg);
	}

	/* Title bar: classic pinstripes + window dots */
	.mail__titlebar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 0.75rem;
		background: repeating-linear-gradient(
			0deg,
			#d6d3ce 0 2px,
			#000 2px 3px,
			#d6d3ce 3px 5px,
			#fff 5px 6px
		);
		border-bottom: 1px solid #000;
	}
	.mail__dot {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		border: 1px solid #000;
		background-color: #fff;
		flex: none;
	}
	.mail__title {
		flex: 1;
		text-align: center;
		font-size: var(--small-font-size);
		font-weight: var(--font-semi-bold);
		color: #000;
		padding: 0.1rem 0.4rem;
		background-color: #d6d3ce;
		border-radius: 4px;
		margin-right: 3rem; /* balance the dots on the left */
	}

	/* Header rows: To / From / Subject */
	.mail__head {
		border-bottom: 1px solid #000;
	}
	.mail__row {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.4rem 0.75rem;
		border-bottom: 1px solid #9a9a9a;
	}
	.mail__row:last-child {
		border-bottom: none;
	}
	.mail__label {
		flex: none;
		width: 4.5rem;
		text-align: right;
		font-size: var(--small-font-size);
		font-weight: var(--font-semi-bold);
		color: #000;
	}
	.mail__value {
		font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, monospace;
		font-size: var(--small-font-size);
		color: #000;
	}
	.mail__from {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex: 1;
		min-width: 0;
		color: #555;
	}
	.mail__input {
		min-width: 0;
		flex: 1;
		background-color: #fff;
		border: 1px solid #000;
		border-radius: 0;
		font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, monospace;
		font-size: var(--small-font-size);
		color: #000;
		padding: 0.2rem 0.4rem;
		outline: none;
	}
	.mail__input:focus {
		box-shadow: 0 0 0 2px #000;
	}
	.mail__input::placeholder {
		color: #9a9a9a;
	}

	/* Message body */
	.mail__body {
		display: block;
		width: 100%;
		border: none;
		border-bottom: 1px solid #000;
		background-color: #fff;
		resize: vertical;
		min-height: 8rem;
		padding: 0.6rem 0.75rem;
		font-family: ui-monospace, 'SF Mono', 'Cascadia Mono', Menlo, monospace;
		font-size: var(--normal-font-size);
		line-height: 1.5;
		color: #000;
		outline: none;
	}
	.mail__body:focus {
		box-shadow: inset 0 0 0 2px #000;
	}
	.mail__body::placeholder {
		color: #9a9a9a;
	}

	/* Toolbar with the beveled Send button */
	.mail__toolbar {
		display: flex;
		justify-content: flex-end;
		padding: 0.6rem 0.75rem;
	}
	.mail__send {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 1.25rem;
		font-size: var(--small-font-size);
		font-weight: var(--font-semi-bold);
		color: #000;
		background-color: #d6d3ce;
		border: 1px solid #000;
		border-radius: 6px;
		/* classic bevel: light top-left, dark bottom-right */
		box-shadow:
			inset 1px 1px 0 #fff,
			inset -1px -1px 0 #9a9a9a;
		cursor: pointer;
	}
	.mail__send:hover {
		background-color: #e4e1dc;
	}
	.mail__send:active {
		box-shadow:
			inset 1px 1px 0 #9a9a9a,
			inset -1px -1px 0 #fff;
	}

	/* Dark theme: graphite window */
	:global(.dark) .mail {
		background-color: #3f3f46;
	}
	:global(.dark) .mail__titlebar {
		background: repeating-linear-gradient(
			0deg,
			#3f3f46 0 2px,
			#000 2px 3px,
			#3f3f46 3px 5px,
			#71717a 5px 6px
		);
	}
	:global(.dark) .mail__title,
	:global(.dark) .mail__label,
	:global(.dark) .mail__value {
		color: #e4e4e7;
	}
	:global(.dark) .mail__title {
		background-color: #3f3f46;
	}
	:global(.dark) .mail__from {
		color: #a1a1aa;
	}
	:global(.dark) .mail__dot {
		background-color: #71717a;
	}
	:global(.dark) .mail__row {
		border-bottom-color: #52525b;
	}
	:global(.dark) .mail__input,
	:global(.dark) .mail__body {
		background-color: #18181b;
		color: #e4e4e7;
		border-color: #000;
	}
	:global(.dark) .mail__input::placeholder,
	:global(.dark) .mail__body::placeholder {
		color: #71717a;
	}
	:global(.dark) .mail__input:focus {
		box-shadow: 0 0 0 2px #a1a1aa;
	}
	:global(.dark) .mail__body:focus {
		box-shadow: inset 0 0 0 2px #a1a1aa;
	}
	:global(.dark) .mail__send {
		background-color: #52525b;
		color: #e4e4e7;
		box-shadow:
			inset 1px 1px 0 #71717a,
			inset -1px -1px 0 #27272a;
	}
	:global(.dark) .mail__send:hover {
		background-color: #606068;
	}
	:global(.dark) .mail__send:active {
		box-shadow:
			inset 1px 1px 0 #27272a,
			inset -1px -1px 0 #71717a;
	}
</style>
